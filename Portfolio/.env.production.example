# PRODUCTION Compose variables for compose.prod.yaml. Copy to `.env.production` on the server
# (never commit it) and start with:  docker compose -f compose.prod.yaml --env-file .env.production up -d
# Django's own settings go in backend/.env.production (see backend/.env.production.example).

POSTGRES_DB=devsphere
POSTGRES_USER=devsphere
# Strong and unique: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
HTTP_PORT=8080

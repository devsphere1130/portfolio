# PRODUCTION settings for the Django API. On a host with a settings dashboard (Render, Railway, Fly, ...)
# enter these there; with compose.prod.yaml copy this file to backend/.env.production. Never commit it.
#
# The app refuses to start if DEBUG is on, the secret key is weak, ALLOWED_HOSTS is "*", or the database
# address is a development-only one. Before each release run:  python manage.py check --deploy

DJANGO_ENV=production
DJANGO_DEBUG=False
# 40+ random characters, different from development: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=www.example.com,example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com,https://example.com
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------------------------------
# compose.prod.yaml sets DATABASE_URL itself (the `db` service); leave this out there.
# Managed Postgres (Neon, Supabase, RDS, ...): paste the provider's URL, e.g.
#   DATABASE_URL=postgres://app_user:password@db.provider.com:5432/devsphere?sslmode=require
# Never use 127.0.0.1 / localhost / host.docker.internal unless PostgreSQL runs on this same server.
# DATABASE_URL=
DATABASE_CONN_MAX_AGE=60

# --- HTTPS & cookies ----------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
# Only when EVERY subdomain is HTTPS-only (preload is very hard to undo):
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SAMESITE=Lax
# Only if the frontend is on a different domain from the API (e.g. Vercel + api.example.com):
# SESSION_COOKIE_SAMESITE=None
# FRONTEND_ORIGINS=https://www.example.com

# --- Media: object storage (container disks are wiped on redeploy on most platforms) -----------------
MEDIA_STORAGE=s3
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_CUSTOM_DOMAIN=media.example.com
# compose.prod.yaml on a single server with its media volume can use: MEDIA_STORAGE=local

# --- Contact form email ------------------------------------------------------------------------------
CONTACT_NOTIFY_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# DEVELOPMENT settings. Copy to `backend/.env` on your own machine.
# Production uses backend/.env.production.example instead (stricter, validated at startup).
# Server-side only: none of these ever reach the browser. Never commit the real files.

# --- Core ---------------------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Database (PostgreSQL only) -----------------------------------------------------------------
# Running Django on your machine against `docker compose up db`. Use 127.0.0.1, not localhost, on Windows
# (localhost tries IPv6 first and each connection waits ~30 s). Inside Docker Compose this is overridden.
DATABASE_URL=postgres://devsphere:change-me@127.0.0.1:5433/devsphere

# --- Browser origins ------------------------------------------------------------------------------
# Every origin that serves the frontend. Dev defaults already cover Vite on :5173 and :4173.
# Production example: https://devsphere.example.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only needed when the frontend runs on a different domain from the API (e.g. Vercel + API host).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Cookies / HTTPS (production) ---------------------------------------------------------------
# Same domain (nginx proxy): keep Lax. Frontend and API on different domains: None (requires HTTPS).
SESSION_COOKIE_SAMESITE=Lax
# Defaults to True whenever DJANGO_DEBUG is off.
# SESSION_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
SESSION_HOURS=8

# --- First admin (used once by `python manage.py bootstrap_admin`; remove the password afterwards) --
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_PASSWORD=

# --- Media storage --------------------------------------------------------------------------------
# local: files in MEDIA_ROOT (a Docker volume in compose). s3: any S3-compatible bucket (recommended in prod).
MEDIA_STORAGE=local
MEDIA_MAX_UPLOAD_MB=8
# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT_URL=          # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_CUSTOM_DOMAIN=         # e.g. media.devsphere.example.com (CDN in front of the bucket)

# --- Contact form email (optional) ----------------------------------------------------------------
CONTACT_NOTIFY_EMAIL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=            # Gmail: a 16-character App Password, not your account password
# DEFAULT_FROM_EMAIL=DevSphere Website <you@example.com>

# --- Rate limits ------------------------------------------------------------------------------------
# CONTACT_THROTTLE_RATE=5/hour
# LOGIN_THROTTLE_IP_RATE=10/min
# LOGIN_THROTTLE_EMAIL_RATE=5/min
# UPLOAD_THROTTLE_RATE=60/hour

# --- WhatsApp (optional) -----------------------------------------------------------------------------
# Click-to-chat needs NONE of these: set the number in the dashboard (Leads & WhatsApp -> Settings).
# Only for the official WhatsApp Business Cloud API (receive messages, reply from the dashboard, delivery status):
# WHATSAPP_ACCESS_TOKEN=          # system-user access token from Meta Business Settings
# WHATSAPP_APP_SECRET=            # Meta app secret; verifies webhook signatures
# WHATSAPP_VERIFY_TOKEN=          # any long random string you also type into Meta's webhook setup
# WHATSAPP_API_VERSION=v23.0
# Local testing without Meta: set WHATSAPP_APP_SECRET to any test value, then
#   python manage.py whatsapp_simulate_webhook --kind message --from 15550100199 --text "Hello"

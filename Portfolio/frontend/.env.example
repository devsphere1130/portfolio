# Frontend build settings. Everything prefixed VITE_ is PUBLIC (bundled into the browser JS) —
# never put secrets here.

# Where the browser sends API requests.
#   Same domain (Vite proxy in dev, nginx in compose.prod.yaml): leave as /api
#   Separate API domain (e.g. frontend on Vercel):              https://api.devsphere.example.com/api
VITE_API_URL=/api

# Dev/preview only: where the Vite proxy forwards /api and /media (not bundled).
# VITE_API_PROXY=http://127.0.0.1:8000

# Docker Compose variables. Copy to `.env` (development) or `.env.production` (compose.prod.yaml).
# Never commit the real files — they are git-ignored.

POSTGRES_DB=devsphere
POSTGRES_USER=devsphere
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me

# Which database Docker uses in development:
#   Postgres in Docker (default):  COMPOSE_PROFILES=docker-db  and DATABASE_URL in backend/.env pointing at
#                                  127.0.0.1:5433 with the POSTGRES_* credentials below.
#   Your own PostgreSQL:           remove COMPOSE_PROFILES, set DOCKER_DATABASE_HOST=host.docker.internal,
#                                  and point DATABASE_URL in backend/.env at 127.0.0.1:5432.
COMPOSE_PROFILES=docker-db
# DOCKER_DATABASE_HOST=host.docker.internal

# Host port for Postgres in development (5433 avoids clashing with a local PostgreSQL on 5432).
POSTGRES_HOST_PORT=5433

# Host port for the dev API container (change if something else already uses 8000).
BACKEND_HOST_PORT=8000

# compose.prod.yaml only: host port for the nginx web container.
HTTP_PORT=8080
